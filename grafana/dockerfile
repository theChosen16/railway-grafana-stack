ARG VERSION=11.5.2

FROM grafana/grafana:${VERSION}

# Install plugins at container start so Railway's volume mount does not mask them.
ENV GF_PLUGINS_PREINSTALL=grafana-clock-panel

# copy provisioning configs
COPY datasources     /etc/grafana/provisioning/datasources
COPY dashboards/provider.yml /etc/grafana/provisioning/dashboards/provider.yml
COPY dashboards/json /etc/grafana/provisioning/dashboards/json
